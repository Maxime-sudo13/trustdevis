# Copiez ce fichier en .env pour personnaliser la stack locale.
# Tout est optionnel : sans .env, docker compose utilise les valeurs par défaut.

# Base PostgreSQL et Redis (locales, non exposées hors de Docker)
POSTGRES_DB=trustdevis
POSTGRES_USER=trustdevis
POSTGRES_PASSWORD=trustdevis_local
REDIS_PASSWORD=trustdevis_local

# MarketScore : enrichissement LLM optionnel (Moonshot / Kimi). Sans clé, le score reste calculé par règles.
KIMI_API_KEY=

# Billing : clés Stripe en mode test (sk_test_... / whsec_...). Sans clé, les plans restent consultables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
