# Configuration
NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=./database/project_manager.db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Notifications
ENABLE_EMAIL_ALERTS=false
EMAIL_FROM=noreply@trustdevis.com

# Seuils d'alertes
BUDGET_ALERT_THRESHOLD=90
DELAY_ALERT_DAYS=3
